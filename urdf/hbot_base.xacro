<?xml version="1.0" ?>
<!-- HBOT mobile base: base_footprint, base_link (chassis), drive wheels and
     caster. Shared by the real robot and the simulation.
     Macros only - instantiated from hbot.urdf.xacro, which defines every
     property used here (see config/hbot_geometry.yaml). -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Chassis collision box: the CAD chassis bounds without lidar and caster.
       Its top (~0.117 m) stays below the lidar scan plane (~0.137 m) so the
       simulated rays never hit the robot's own body (checked by
       test/test_description.py). -->
  <xacro:property name="body_length" value="${cad_body_max_x - cad_body_min_x}"/>
  <xacro:property name="body_width"  value="${cad_body_max_y - cad_body_min_y}"/>
  <xacro:property name="body_height" value="${cad_body_max_z - cad_body_min_z}"/>
  <xacro:property name="body_center" value="${(cad_body_max_x + cad_body_min_x)/2} ${(cad_body_max_y + cad_body_min_y)/2} ${(cad_body_max_z + cad_body_min_z)/2}"/>

  <!-- base_footprint (on the ground) and base_link (the chassis) -->
  <xacro:macro name="hbot_base">
    <link name="base_footprint"/>

    <joint name="base_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://hbot_description/meshes/base_link.stl"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="${body_center}" rpy="0 0 0"/>
        <geometry>
          <box size="${body_length} ${body_width} ${body_height}"/>
        </geometry>
      </collision>
      <xacro:solid_cuboid_inertial
        rpy="0 0 0" xyz="${body_center}" mass="${geo.mass.base}"
        x="${body_length}" y="${body_width}" z="${body_height}"
      />
    </link>
  </xacro:macro>

  <!-- Drive wheel. meshes/wheel.stl is the LEFT wheel (hub facing the chassis);
       the right one is the same mesh turned 180 deg about z. The joint is
       continuous in sim and fixed on the real robot (see driver_joint_states
       in hbot.urdf.xacro). -->
  <xacro:macro name="wheel" params="prefix y_reflect mesh_yaw">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${mesh_yaw}"/>
        <geometry>
          <mesh filename="package://hbot_description/meshes/wheel.stl"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:solid_cylinder_inertial
        rpy="${pi/2} 0 0" xyz="0 0 0" mass="${geo.mass.wheel}"
        radius="${wheel_radius}" length="${wheel_width}"
      />
    </link>

    <joint name="${prefix}_joint" type="${wheel_joint_type}">
      <parent link="base_link"/>
      <child link="${prefix}_link"/>
      <origin xyz="0 ${y_reflect*wheel_separation/2} ${wheel_radius}" rpy="0 0 0"/>
      <xacro:if value="${wheel_joint_type == 'continuous'}">
        <axis xyz="0 1 0"/>
      </xacro:if>
    </joint>
  </xacro:macro>

  <!-- Caster ball. Its visual is part of base_link.stl; this link only
       carries the contact sphere (frictionless in Gazebo). -->
  <xacro:macro name="caster">
    <link name="front_caster">
      <collision>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <xacro:null_inertial/>
    </link>

    <joint name="front_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="front_caster"/>
      <origin xyz="${caster_x} ${caster_y} ${caster_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

</robot>
