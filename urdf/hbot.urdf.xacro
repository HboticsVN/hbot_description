<?xml version="1.0" ?>
<robot name="hbot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ==========================================================================
       HBOT AMR - the single entry point of the robot description
       (README.md):

         xacro hbot.urdf.xacro                -> real robot (robot_state_publisher
                                                 on the Pi, SLAM / Nav2 / RViz)
         xacro hbot.urdf.xacro use_sim:=true  -> Gazebo model (+ sensors,
                                                 diff-drive plugin, friction)

       Both variants contain the same links, joints, visuals, collisions and
       inertias; use_sim only adds the <gazebo> extensions. Every dimension
       comes from config/hbot_geometry.yaml (which may defer to the CAD values
       in cad_params.xacro) - no robot dimension is typed into the xacro files.

       Frames (REP-103 / REP-105):
         base_footprint  on the ground, under the mid-point of the drive axle
         base_link       coincident with base_footprint
         left/right_wheel_link, front_caster
         laser           YDLidar X3 head centre, on the scan plane (the frame_id
                         the ydlidar driver stamps on /scan)
         imu_link        Rosmaster board IMU
       x points forward (toward the caster), y left, z up.
       ========================================================================== -->

  <!-- ===== Arguments ===== -->
  <xacro:arg name="use_sim" default="false"/>
  <!-- The real driver does not publish /joint_states yet, so on the real robot
       the wheels are fixed joints (robot_state_publisher then publishes their
       TF itself). Set true once hbot_driver publishes the wheel joint states. -->
  <xacro:arg name="driver_joint_states" default="false"/>

  <!-- xacro args are strings ("false" is truthy in Python): convert once here. -->
  <xacro:property name="use_sim" value="${'$(arg use_sim)'.lower() in ('true', '1')}"/>
  <xacro:property name="driver_joint_states" value="${'$(arg driver_joint_states)'.lower() in ('true', '1')}"/>

  <!-- ===== Parameters ===== -->
  <!-- CAD measurements (generated by scripts/prepare_meshes.py - never edit) -->
  <xacro:include filename="cad_params.xacro"/>
  <!-- Robot geometry (edit this one). The path is relative to this file, so it
       works from the source tree and from the install space alike. -->
  <xacro:property name="geo" value="${xacro.load_yaml('../config/hbot_geometry.yaml')}" lazy_eval="false"/>

  <!-- Resolve `cad` entries of the YAML to the measured CAD values. -->
  <xacro:property name="wheel_separation" value="${cad_wheel_separation if geo.wheels.track  == 'cad' else geo.wheels.track}"/>
  <xacro:property name="wheel_radius"     value="${cad_wheel_radius     if geo.wheels.radius == 'cad' else geo.wheels.radius}"/>
  <xacro:property name="wheel_width"      value="${cad_wheel_width      if geo.wheels.width  == 'cad' else geo.wheels.width}"/>
  <xacro:property name="caster_x"         value="${cad_caster_x         if geo.caster.x      == 'cad' else geo.caster.x}"/>
  <xacro:property name="caster_y"         value="${cad_caster_y         if geo.caster.y      == 'cad' else geo.caster.y}"/>
  <xacro:property name="caster_radius"    value="${cad_caster_radius    if geo.caster.radius == 'cad' else geo.caster.radius}"/>
  <xacro:property name="laser_x"          value="${cad_laser_x          if geo.laser.x       == 'cad' else geo.laser.x}"/>
  <xacro:property name="laser_y"          value="${cad_laser_y          if geo.laser.y       == 'cad' else geo.laser.y}"/>
  <xacro:property name="laser_z"          value="${cad_laser_z          if geo.laser.z       == 'cad' else geo.laser.z}"/>
  <xacro:property name="laser_yaw"        value="${geo.laser.yaw}"/>

  <xacro:property name="wheel_joint_type" value="${'continuous' if (use_sim or driver_joint_states) else 'fixed'}"/>

  <!-- ===== Model ===== -->
  <xacro:include filename="materials.xacro"/>
  <xacro:include filename="inertials.xacro"/>
  <xacro:include filename="hbot_base.xacro"/>
  <xacro:include filename="hbot_sensors.xacro"/>

  <xacro:hbot_base/>
  <xacro:wheel prefix="left_wheel"  y_reflect="1"  mesh_yaw="0"/>
  <xacro:wheel prefix="right_wheel" y_reflect="-1" mesh_yaw="${pi}"/>
  <xacro:caster/>
  <xacro:laser_sensor/>
  <xacro:imu_sensor/>

  <!-- ===== Simulation only ===== -->
  <xacro:if value="${use_sim}">
    <xacro:include filename="hbot.gazebo.xacro"/>
  </xacro:if>

</robot>
