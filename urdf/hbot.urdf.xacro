<?xml version="1.0" ?>
<robot name="hbot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ==========================================================================
       HBOT AMR - single source for both robot descriptions (see
       docs/cad_model.md):

         xacro hbot.urdf.xacro            -> hbot.urdf      real robot: TF frames
                                                            only, for SLAM / Nav2
         xacro hbot.urdf.xacro sim:=true  -> hbot_sim.urdf  Gazebo: + CAD meshes,
                                                            collisions, inertias,
                                                            wheels, caster, plugins

       Frames (REP-103 / REP-105), identical in both:
         base_footprint  on the ground, under the mid-point of the drive axle
         base_link       coincident with base_footprint
         laser           YDLidar X3 head centre, on the scan plane (the frame_id
                         the ydlidar driver stamps on /scan)
         imu_link        Rosmaster board IMU, at the base origin
       x points forward (toward the caster), y left, z up.
       ========================================================================== -->

  <xacro:arg name="sim" default="false"/>
  <xacro:property name="sim" value="$(arg sim)"/>

  <!-- Dimensions measured from the CAD (models/*.stl) by
       scripts/prepare_meshes.py - regenerate, never hand-edit. -->
  <xacro:include filename="cad_params.xacro" />

  <!-- Drive wheels. The track is the real wheel_track (190-200 mm); the CAD
       places the wheels at cad_wheel_separation (~183 mm). Keep this in sync
       with wheel_track in hbot_bringup/config/yahboom_driver_params.yaml. -->
  <xacro:property name="wheel_separation" value="0.195"/>
  <xacro:property name="wheel_radius"     value="${cad_wheel_radius}"/>
  <xacro:property name="wheel_width"      value="${cad_wheel_width}"/>

  <xacro:if value="${sim}">
    <xacro:include filename="inertials.xacro" />
    <xacro:include filename="materials.xacro" />
    <xacro:include filename="hbot_body.xacro" />
  </xacro:if>

  <!-- ===== Frames shared by the real robot and the simulation ===== -->

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <xacro:if value="${sim}"><xacro:base_body/></xacro:if>
  </link>

  <link name="laser">
    <xacro:if value="${sim}"><xacro:lidar_body/></xacro:if>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="${cad_laser_x} ${cad_laser_y} ${cad_laser_z}" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- The real driver publishes no /joint_states, so the wheel joints stay
       out of hbot.urdf - otherwise their TF would be missing on the robot. -->
  <xacro:if value="${sim}">
    <!-- ===== Simulation only ===== -->
    <xacro:wheel prefix="left_wheel"  y_reflect="1"  mesh_yaw="0"/>
    <xacro:wheel prefix="right_wheel" y_reflect="-1" mesh_yaw="${pi}"/>
    <xacro:caster/>
    <xacro:include filename="hbot.gazebo.xacro" />
  </xacro:if>

</robot>
